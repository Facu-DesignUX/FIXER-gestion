<Window x:Class="FIXER.Desktop.Views.RegistrarMermaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FIXER.Desktop.Converters"
        Title="Registrar Merma / Deterioro de Existencias"
        Height="450" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Baja por Merma o Rotura" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Exige obligatoriamente una justificación escrita para auditar el descuento de stock." 
                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <Separator Margin="0,12,0,0" Background="#E2E8F0"/>
        </StackPanel>

        <!-- Formulario -->
        <StackPanel Grid.Row="1">
            <!-- Producto y Stock Disponible -->
            <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Artículo a descontar:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NombreProducto}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <TextBlock Text="Stock Actual:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StockDisponible, StringFormat={}{0:0.###}}" FontSize="15" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cantidad a descontar -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Cantidad Física a Dar de Baja *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CantidadADescontar, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" 
                         Height="34" Padding="8,6" FontSize="14" FontWeight="SemiBold" BorderBrush="#CBD5E1"/>
            </StackPanel>

            <!-- Justificación escrita obligatoria (RF-009 / CU-05) -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Motivo o Justificación Escrita Obligatoria *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Justificacion, UpdateSourceTrigger=PropertyChanged}" 
                         Height="75" Padding="8,6" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" BorderBrush="#CBD5E1"/>
            </StackPanel>
        </StackPanel>

        <!-- Mensaje de Error si ocurre -->
        <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                Visibility="{Binding MensajeError, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" 
                    Width="100" Height="36" Margin="0,0,12,0"
                    Background="White" Foreground="#475569" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Asentar Merma" Command="{Binding ConfirmarMermaCommand}" 
                    Width="140" Height="36" 
                    Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>

