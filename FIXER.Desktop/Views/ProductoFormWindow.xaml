<Window x:Class="FIXER.Desktop.Views.ProductoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FIXER.Desktop.Converters"
        Title="{Binding TituloVentana}"
        Height="620" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding TituloVentana}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Complete los atributos del artículo para el catálogo maestro." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            <Separator Margin="0,12,0,0" Background="#E2E8F0"/>
        </StackPanel>

        <!-- Formulario con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Nombre del Producto -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Descripción Comercial / Nombre *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1"/>
                </StackPanel>

                <!-- Categoría y Proveedor en 2 columnas -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Categoría *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Categorias}" 
                                  SelectedItem="{Binding CategoriaSeleccionada}"
                                  DisplayMemberPath="NombreCategoria"
                                  Height="34" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Proveedor / Distribuidor *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Proveedor, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Grid>

                <!-- Precios: Costo y Venta -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Costo de Adquisición ($) *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Costo, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}" Height="34" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Precio de Venta ($) *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}" Height="34" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Grid>

                <!-- Unidad de Medida y Ubicación Física -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Unidad de Medida *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding UnidadesMedida}" 
                                  SelectedItem="{Binding UnidadMedida}"
                                  Height="34" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ubicación Física (Pasillo/Estante) *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding UbicacionFisica, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Grid>

                <!-- Stock Inicial y Stock Mínimo -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Existencias / Stock *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" Height="34" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Umbral Stock Mínimo *" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" Height="34" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="* Si la unidad de medida es 'Unidad', el stock debe ser número entero." 
                           FontSize="11" FontStyle="Italic" Foreground="#64748B"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Mensaje de Error si ocurre -->
        <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,12,0,0"
                Visibility="{Binding MensajeError, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" 
                    Width="110" Height="36" Margin="0,0,12,0"
                    Background="White" Foreground="#475569" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Guardar Producto" Command="{Binding GuardarCommand}" 
                    Width="150" Height="36" 
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
