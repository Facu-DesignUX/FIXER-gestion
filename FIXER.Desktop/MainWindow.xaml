<Window x:Class="FIXER.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FIXER.Desktop.Converters"
        Title="FIXER Gestión - Ferretería El Reparo (Punto de Venta e Inventario)" 
        Height="768" Width="1200"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <conv:StockCriticoTextColorConverter x:Key="StockCriticoTextColorConverter"/>
        <conv:EstadoColorConverter x:Key="EstadoColorConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú Lateral / NavigationRail (§6.1) -->
            <ColumnDefinition Width="220"/>
            <!-- Área Principal de Trabajo -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Menú Lateral Izquierdo -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo / Marca -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="6" Width="36" Height="36" Margin="0,0,10,0">
                            <TextBlock Text="FX" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="FIXER" Foreground="White" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="Gestión Ferretera" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="v4.0 - Ferretería El Reparo" Foreground="#64748B" FontSize="10" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Navegación de Módulos (§6.2) -->
                <StackPanel Grid.Row="1">
                    <!-- Módulo Activo: Inventario -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <TextBlock Text="📦  Inventario y Catálogo" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                    
                    <!-- Módulos Futuros del Sistema con opacidad para contexto -->
                    <Border Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" Opacity="0.6">
                        <TextBlock Text="🛒  Punto de Venta POS" Foreground="#CBD5E1" FontSize="13"/>
                    </Border>

                    <Border Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" Opacity="0.6">
                        <TextBlock Text="💵  Caja Diaria y Turnos" Foreground="#CBD5E1" FontSize="13"/>
                    </Border>

                    <Border Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" Opacity="0.6">
                        <TextBlock Text="📊  Reportes Gerenciales" Foreground="#CBD5E1" FontSize="13"/>
                    </Border>

                    <Border Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" Opacity="0.6">
                        <TextBlock Text="👥  Gestión de Usuarios" Foreground="#CBD5E1" FontSize="13"/>
                    </Border>
                </StackPanel>

                <!-- Pie de Menú: Rol Actual -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Usuario activo:" Foreground="#64748B" FontSize="10"/>
                        <TextBlock Text="Mario Santos (Dueño)" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                        <Border Background="#166534" CornerRadius="4" HorizontalAlignment="Left" Padding="6,2" Margin="0,4,0,0">
                            <TextBlock Text="ROL: ADMINISTRADOR" Foreground="#86EFAC" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Contenido Principal: Módulo de Inventario y Catálogo -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <!-- Fila 0: Barra Superior / Título y Métricas -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 1: Filtros de Búsqueda Reactiva -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 2: Tabla de Artículos Paginada -->
                <RowDefinition Height="*"/>
                <!-- Fila 3: Paginación y Estado -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Fila 0: Encabezado y Métricas Rápidas -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Catálogo de Artículos e Inventario" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Consulta de existencias en tiempo real, ubicación física y alertas de reposición." FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Tarjetas resumen de métricas -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tarjeta Total Activos -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Artículos Activos" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalProductosActivos}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta Alerta Stock Mínimo -->
                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="En Stock Crítico" FontSize="11" Foreground="#991B1B"/>
                                <TextBlock Text="{Binding TotalStockCritico}" FontSize="15" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Fila 1: Barra de Filtros y Acciones Principales -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Buscador por texto (Nombre/Código/Pasillo) -->
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Filtro Categoría -->
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Filtro Proveedor -->
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Botón Buscar / Limpiar -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <!-- Botones de Acción (Nuevo Producto, Registrar Merma) -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buscador Libre -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Buscar (Nombre, Código o Pasillo):" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="32" Padding="8,4" FontSize="12" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Combo Categorías -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Categoría:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Categorias}" 
                                  SelectedItem="{Binding CategoriaFiltro}"
                                  DisplayMemberPath="NombreCategoria"
                                  Height="32" FontSize="12"/>
                    </StackPanel>

                    <!-- Combo Proveedores -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Proveedor:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Proveedores}" 
                                  SelectedItem="{Binding ProveedorFiltro}"
                                  Height="32" FontSize="12"/>
                    </StackPanel>

                    <!-- Botones Filtrar -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="🔍 Buscar" Command="{Binding BuscarCommand}" 
                                Width="85" Height="32" Margin="0,0,6,0"
                                Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12"/>
                        <Button Content="↺ Limpiar" Command="{Binding LimpiarFiltrosCommand}" 
                                Width="75" Height="32"
                                Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" Cursor="Hand" FontSize="12"/>
                    </StackPanel>

                    <!-- Botones de Acción: Nuevo Producto y Merma -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="⚠️ Registrar Merma" Command="{Binding RegistrarMermaCommand}"
                                Width="140" Height="32" Margin="0,0,10,0"
                                Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FCA5A5" Cursor="Hand" FontWeight="SemiBold" FontSize="12"/>
                        <Button Content="➕ Nuevo Producto" Command="{Binding NuevoProductoCommand}" 
                                Width="140" Height="32" 
                                Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Fila 2: DataGrid de Catálogo con Resaltado de Stock Crítico (§6.3 Pantalla 3) -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="0">
                <DataGrid ItemsSource="{Binding Productos}" 
                          SelectedItem="{Binding ProductoSeleccionado}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          RowHeight="36"
                          FontSize="12">

                    <!-- Estilo de encabezados -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Estilo de fila para pintar el fondo suave si stock <= stockMinimo -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding EstaEnStockCritico, Converter={StaticResource BoolToColorConverter}}"/>
                            <Setter Property="Foreground" Value="{Binding EstaEnStockCritico, Converter={StaticResource StockCriticoTextColorConverter}}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0F2FE"/>
                                    <Setter Property="Foreground" Value="#0369A1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- Columnas del Modelo Relacional / DFD -->
                    <DataGrid.Columns>
                        <!-- Código -->
                        <DataGridTextColumn Header="Cód." Binding="{Binding IdProducto}" Width="55"/>

                        <!-- Nombre -->
                        <DataGridTextColumn Header="Descripción / Artículo" Binding="{Binding Nombre}" Width="2*"/>

                        <!-- Categoría -->
                        <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="1.3*"/>

                        <!-- Proveedor -->
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="1*"/>

                        <!-- Ubicación Física (RF-001) -->
                        <DataGridTextColumn Header="Ubicación Física" Binding="{Binding UbicacionFisica}" Width="1.2*"/>

                        <!-- Unidad de Medida -->
                        <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadMedida}" Width="75"/>

                        <!-- Precio Venta -->
                        <DataGridTextColumn Header="Precio ($)" Binding="{Binding PrecioVenta, StringFormat={}{0:C2}}" Width="1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Stock Actual con Alerta -->
                        <DataGridTemplateColumn Header="Stock Actual" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                                        <TextBlock Text="⚠️ " Visibility="{Binding EstaEnStockCritico, Converter={StaticResource NullToVisibilityConverter}}" Foreground="#DC2626"/>
                                        <TextBlock Text="{Binding StockFormateado}" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Stock Mínimo -->
                        <DataGridTextColumn Header="Stock Mín." Binding="{Binding StockMinimoFormateado}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Estado (Baja Lógica RNF-006) -->
                        <DataGridTemplateColumn Header="Estado" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstadoTexto}" 
                                               Foreground="{Binding EstadoActivo, Converter={StaticResource EstadoColorConverter}}" 
                                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones directas por fila -->
                        <DataGridTemplateColumn Header="Acciones" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✏️ Editar" 
                                                Command="{Binding DataContext.EditarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" Margin="0,0,4,0" FontSize="11" Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
                                        <Button Content="Baja/Alta" 
                                                Command="{Binding DataContext.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" FontSize="11" Background="#F8FAFC" BorderBrush="#CBD5E1" Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Fila 3: Barra Inferior con Paginación (§6.3 Pantalla 3: 20 productos por página) -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mensaje de Estado -->
                <TextBlock Grid.Column="0" Text="{Binding MensajeEstado}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                <!-- Controles de Paginación -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorCommand}" 
                            IsEnabled="{Binding PuedeRetroceder}"
                            Width="90" Height="30" Margin="0,0,8,0"
                            Background="White" Foreground="#475569" BorderBrush="#CBD5E1" Cursor="Hand" FontSize="12"/>
                    
                    <TextBlock VerticalAlignment="Center" Margin="6,0,14,0" FontSize="12" Foreground="#334155" FontWeight="SemiBold">
                        <Run Text="Página "/><Run Text="{Binding PaginaActual}"/><Run Text=" de "/><Run Text="{Binding TotalPaginas}"/>
                    </TextBlock>

                    <Button Content="Siguiente ▶" Command="{Binding PaginaSiguienteCommand}" 
                            IsEnabled="{Binding PuedeAvanzar}"
                            Width="95" Height="30" 
                            Background="White" Foreground="#475569" BorderBrush="#CBD5E1" Cursor="Hand" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
